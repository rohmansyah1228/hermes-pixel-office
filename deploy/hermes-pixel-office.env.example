# Salin ke /etc/hermes-pixel-office.env  lalu:  sudo chmod 600 /etc/hermes-pixel-office.env
# Password (disarankan bila dibuka lewat domain publik). Buat hash:  python3 hermes_bridge.py --hash
# lalu tempel barisnya di sini. install.sh juga menanyakannya.
#BRIDGE_PASSWORD_HASH=
# Sesi habis setelah sekian menit tanpa aktivitas (halaman terbuka dihitung aktif):
#BRIDGE_SESSION_MINUTES=120

BRIDGE_PORT=8114

# Sumber data (pilih salah satu; boleh keduanya, API didahulukan):
# A) Baca langsung database sesi Hermes (paling mudah, tanpa API key). Bawaan ~/.hermes/state.db
HERMES_DB=/home/USER/.hermes/state.db
# B) API server Hermes (perlu API_SERVER_ENABLED=true dan API_SERVER_KEY di ~/.hermes/.env)
#HERMES_API_URL=http://127.0.0.1:8642
#HERMES_API_KEY=ISI_SAMA_DENGAN_API_SERVER_KEY
# C) agent-office (opsional, bila Anda memakainya)
#AGENT_OFFICE_URL=http://127.0.0.1:8113

